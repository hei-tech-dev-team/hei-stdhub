# ─── Backend API URL ──────────────────
# No frontend .env is committed: the app falls back to http://localhost:3001.
# For a local override, create frontend/.env.local (ignored by git).
# Production: set VITE_API_URL in the Vercel project settings.
VITE_API_URL=http://localhost:3001

# ─── Auth API URL (optional) ──────────
# Auth proxy origin, without /api/auth. Defaults to VITE_API_URL in dev and to
# the same-origin /api/auth proxy in production. Do not point this at Render
# directly in production: the refresh cookie is SameSite=Strict and host-only.
VITE_AUTH_API_URL=
