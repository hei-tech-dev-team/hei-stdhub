# ─── Backend API URL ──────────────────
VITE_API_URL=http://localhost:3001

# ─── Auth API URL (optional) ──────────
# Auth proxy origin, without /api/auth. Defaults to VITE_API_URL in dev and to
# the same-origin /api/auth proxy in production. Do not point this at Render
# directly in production: the refresh cookie is SameSite=Strict and host-only.
VITE_AUTH_API_URL=
