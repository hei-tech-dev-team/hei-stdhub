# ─── HEI STDhub backend environment ───
# Copy to the repository-root `.env` for local development only:
#   cp .env.example .env
# The backend loads `../.env` (see backend/server.js).
#
# NEVER commit a real `.env`. Production values belong in the hosting
# provider's secret store (Render → Environment) and in GitHub Environments.
# Rotation procedure: docs/SECRET_ROTATION.md.

# ─── Environment ──────────────────────
NODE_ENV=development

# ─── Server ───────────────────────────
PORT=3001
PUBLIC_API_URL=http://localhost:3001
# Optional self-ping URL used by the Render keep-alive loop.
# BACKEND_URL=

# ─── Database (REQUIRED) ──────────────
DATABASE_URL=postgresql://user:password@localhost:5432/hei_stdhub

# ─── JWT et sessions (REQUIRED) ───────
JWT_SECRET=your-secret-key-here
JWT_ISSUER=hei-stdhub-api
JWT_AUDIENCE=hei-stdhub-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=15
AUTH_CACHE_TTL_MS=15000
MAX_SESSIONS_PER_USER=20
SESSION_RETENTION_DAYS=30

# ─── Auth proxy (Vercel → Render) ─────
# Must be identical to AUTH_PROXY_SECRET on the Vercel side.
AUTH_PROXY_SECRET=

# ─── Frontend URL (REQUIRED) ──────────
CLIENT_URL=http://localhost:5173

# ─── Email — legacy reset flow (optional) ─
# The main password-reset flow uses Web Push. This SMTP/Resend path is
# scheduled for removal (#202); rotate or remove the values if still used.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.email@gmail.com
SMTP_PASS=app-password-here
SMTP_FROM=HEI STDhub <stdhub.admin@gmail.com>

# RESEND_API_KEY=re_...
# RESEND_FROM=HEI STDhub <onboarding@resend.dev>

# ─── Cloudinary (optional) ────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─── VAPID (push notifications) ───────
# Required in production (the server refuses to start without them).
# Generate a new pair with: node scripts/rotate-secrets.js
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# ─── Socket.io tuning ─────────────────
SOCKET_PING_TIMEOUT=20000
SOCKET_PING_INTERVAL=25000
SOCKET_MAX_BUFFER=1048576
SOCKET_DEFLATE_THRESHOLD=1024

# ─── Rate limiting ────────────────────
MAX_ONLINE_USERS=5000
REQUEST_TIMEOUT=30000
