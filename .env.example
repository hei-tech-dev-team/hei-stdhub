# ─── Environment ──────────────────────
NODE_ENV=development

# ─── Server ───────────────────────────
PORT=3001

# ─── Google ───────────────────────────
GOOGLE_API_KEY=

# ─── Database (REQUIRED) ──────────────
DATABASE_URL=postgresql://user:password@localhost:5432/hei_stdhub

# ─── JWT et sessions (REQUIRED) ───────
JWT_SECRET=your-secret-key-here
JWT_ISSUER=hei-stdhub-api
JWT_AUDIENCE=hei-stdhub-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=15
AUTH_CACHE_TTL_MS=15000
MAX_SESSIONS_PER_USER=20
SESSION_RETENTION_DAYS=30

# ─── Auth proxy (Vercel → Render) ─────
# Doit être identique à AUTH_PROXY_SECRET côté Vercel.
AUTH_PROXY_SECRET=

# ─── Frontend URL (REQUIRED) ──────────
CLIENT_URL=http://localhost:5173

# ─── Backend URL (REQUIRED FOR MULTER)
PUBLIC_API_URL=http://localhost:3001

# ─── Email — SMTP (Gmail / other) ─────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=votre.email@gmail.com
SMTP_PASS=app-password-here
SMTP_FROM=HEI STDhub <stdhub.admin@gmail.com>

# ─── Email — Resend (alternative) ─────
# RESEND_API_KEY=re_...
# RESEND_FROM=HEI STDhub <onboarding@resend.dev>

# ─── Cloudinary (optional) ────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─── VAPID (push notifications) ───────
# Required in production (server exits without them); auto-generated in dev only.
# Generate once: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# ─── Socket.io tuning ─────────────────
SOCKET_PING_TIMEOUT=20000
SOCKET_PING_INTERVAL=25000
SOCKET_MAX_BUFFER=1048576
SOCKET_DEFLATE_THRESHOLD=1024

# ─── Rate limiting ────────────────────
MAX_ONLINE_USERS=5000
REQUEST_TIMEOUT=30000
